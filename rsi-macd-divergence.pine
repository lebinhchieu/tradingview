//@version=6
indicator(title="RSI + MACD Divergence", shorttitle="RSI+MACD Div", format=format.price, precision=2)

// ─── RSI Settings ────────────────────────────────────────────────────────────
rsiLengthInput = input.int(14,  "RSI Length", minval=1,  group="RSI Settings")
rsiSourceInput = input.source(close, "Source",           group="RSI Settings")
obLevel        = input.int(70, "Overbought Level",       group="RSI Settings")
osLevel        = input.int(30, "Oversold Level",         group="RSI Settings")

// ─── MACD Settings ───────────────────────────────────────────────────────────
macdSourceInput = input.source(close, "Source",          group="MACD Settings")
fastLenInput    = input.int(12, "Fast Length",  minval=1, group="MACD Settings")
slowLenInput    = input.int(26, "Slow Length",  minval=1, group="MACD Settings")
sigLenInput     = input.int(9,  "Signal Length", minval=1, group="MACD Settings")
normPeriod      = input.int(200, "Norm Lookback Period", minval=20, group="MACD Settings")

// ─── Divergence Settings ─────────────────────────────────────────────────────
lookbackRight  = input.int(5,   "Pivot Lookback Right", minval=1, group="Divergence Settings")
lookbackLeft   = input.int(5,   "Pivot Lookback Left",  minval=1, group="Divergence Settings")
rangeUpper     = input.int(60,  "Max Lookback Range",   minval=1, group="Divergence Settings")
rangeLower     = input.int(5,   "Min Lookback Range",   minval=1, group="Divergence Settings")
showDivLabels  = input.bool(false, "Show Divergence Labels", group="Divergence Settings")
enforcePotZone = input.bool(true, "Potential: Enforce Opposite Pivot Zone", group="Divergence Settings")

// ─── MTF Table Settings ──────────────────────────────────────────────────────
tablePos = input.string("top_left", "Table Position",
     options=["top_left","top_right","bottom_left","bottom_right","top_center","bottom_center"],
     group="MTF Table Settings")
show1m   = input.bool(true,  "1m",  inline="tfs", group="MTF Table Settings")
show5m   = input.bool(true,  "5m",  inline="tfs", group="MTF Table Settings")
show15m  = input.bool(true,  "15m", inline="tfs", group="MTF Table Settings")
show1h   = input.bool(true,  "1h",  inline="tfs", group="MTF Table Settings")
show4h   = input.bool(true,  "4h",  inline="tfs", group="MTF Table Settings")

// ─── RSI Calculation ─────────────────────────────────────────────────────────
rsiChange = ta.change(rsiSourceInput)
rsiUp     = ta.rma(math.max(rsiChange, 0), rsiLengthInput)
rsiDown   = ta.rma(-math.min(rsiChange, 0), rsiLengthInput)
rsi       = rsiDown == 0 ? 100 : rsiUp == 0 ? 0 : 100 - (100 / (1 + rsiUp / rsiDown))

// ─── MACD Calculation ────────────────────────────────────────────────────────
maFast = ta.ema(macdSourceInput, fastLenInput)
maSlow = ta.ema(macdSourceInput, slowLenInput)
macd   = maFast - maSlow
signal = ta.ema(macd, sigLenInput)
hist   = macd - signal

// ─── MACD Normalization — scale relative to prior-period range (values may exceed 0-100) ───
macdHigh   = ta.highest(macd[1],   normPeriod)
macdLow    = ta.lowest(macd[1],    normPeriod)
sigHigh    = ta.highest(signal[1], normPeriod)
sigLow     = ta.lowest(signal[1],  normPeriod)
macdNorm   = macdHigh != macdLow ? (macd   - macdLow) / (macdHigh - macdLow) * 60 + 20 : 50.0
signalNorm = sigHigh  != sigLow  ? (signal - sigLow)  / (sigHigh  - sigLow)  * 60 + 20 : 50.0
histAbsMax = math.max(math.abs(ta.highest(hist[1], normPeriod)), math.abs(ta.lowest(hist[1], normPeriod)))
histNorm   = histAbsMax != 0.0 ? hist / histAbsMax * 30 + 50 : 50.0

// Display lookback values — normalized, ready to plot directly (no +50 needed)
histDispLBR = histNorm[lookbackRight]
macdDispLBR = macdNorm[lookbackRight]

f_isInRange(barsSince, rngLow, rngHigh) =>
    not na(barsSince) and barsSince >= rngLow and barsSince <= rngHigh

f_barsAgo(offset) =>
    math.max(0, -int(offset))

f_isBullPotValid(oscPivot, pricePivot, oscValue, lastBullOsc, lastBullPrice, oppositeBearOsc, priceValue, barsSinceBull, rngLow, rngHigh, enforceZone) =>
    hasBullRef = not na(lastBullOsc) and not na(lastBullPrice)
    withinZone = not enforceZone or na(oppositeBearOsc) or oscValue < oppositeBearOsc
    oscPivot and pricePivot and hasBullRef and oscValue > lastBullOsc and withinZone and priceValue < lastBullPrice and f_isInRange(barsSinceBull, rngLow, rngHigh)

f_isBearPotValid(oscPivot, pricePivot, oscValue, lastBearOsc, lastBearPrice, oppositeBullOsc, priceValue, barsSinceBear, rngLow, rngHigh, enforceZone) =>
    hasBearRef = not na(lastBearOsc) and not na(lastBearPrice)
    withinZone = not enforceZone or na(oppositeBullOsc) or oscValue > oppositeBullOsc
    oscPivot and pricePivot and hasBearRef and oscValue < lastBearOsc and withinZone and priceValue > lastBearPrice and f_isInRange(barsSinceBear, rngLow, rngHigh)

// ─── MTF Potential Divergence Function (uses close/low/high from requested TF) ─
f_potDiv(rsiLen, fast, slow, sig, lbLeft, lbRight, rngLow, rngHigh) =>
    rsiChg  = ta.change(close)
    rUp     = ta.rma(math.max(rsiChg, 0), rsiLen)
    rDn     = ta.rma(-math.min(rsiChg, 0), rsiLen)
    rsiV    = rDn == 0 ? 100 : rUp == 0 ? 0 : 100 - (100 / (1 + rUp / rDn))
    mFast   = ta.ema(close, fast)
    mSlow   = ta.ema(close, slow)
    macdV   = mFast - mSlow
    sigV    = ta.ema(macdV, sig)
    histV   = macdV - sigV

    // Normalize MACD and histogram first so confirmed pivots match the displayed series.
    macdVHigh    = ta.highest(macdV[1], normPeriod)
    macdVLow     = ta.lowest(macdV[1],  normPeriod)
    macdVNorm    = macdVHigh != macdVLow ? (macdV - macdVLow) / (macdVHigh - macdVLow) * 60 + 20 : 50.0
    histVAbsMax  = math.max(math.abs(ta.highest(histV[1], normPeriod)), math.abs(ta.lowest(histV[1], normPeriod)))
    histVNorm    = histVAbsMax != 0.0 ? histV / histVAbsMax * 30 + 50 : 50.0

    rsiPl  = not na(ta.pivotlow(rsiV,  lbLeft, lbRight))
    rsiPh  = not na(ta.pivothigh(rsiV, lbLeft, lbRight))
    histPl = not na(ta.pivotlow(histVNorm,  lbLeft, lbRight))
    histPh = not na(ta.pivothigh(histVNorm, lbLeft, lbRight))
    macdPl = not na(ta.pivotlow(macdVNorm,  lbLeft, lbRight))
    macdPh = not na(ta.pivothigh(macdVNorm, lbLeft, lbRight))

    bsRPl = ta.barssince(rsiPl)
    bsRPh = ta.barssince(rsiPh)
    bsHPl = ta.barssince(histPl)
    bsHPh = ta.barssince(histPh)
    bsMPl = ta.barssince(macdPl)
    bsMPh = ta.barssince(macdPh)

    rV_lbr = rsiV[lbRight]
    lo_lbr = low[lbRight]
    hi_lbr = high[lbRight]
    hV_lbr = histVNorm[lbRight]
    mV_lbr = macdVNorm[lbRight]

    histVNormLBR = histVNorm[lbRight]
    macdVNormLBR = macdVNorm[lbRight]

    rPlRsi  = ta.valuewhen(rsiPl,  rV_lbr,      0)
    rPlLow  = ta.valuewhen(rsiPl,  lo_lbr,      0)
    rPhRsi  = ta.valuewhen(rsiPh,  rV_lbr,      0)
    rPhHigh = ta.valuewhen(rsiPh,  hi_lbr,      0)
    // Potential references use normalized values (consistent with visual space)
    hPlH    = ta.valuewhen(histPl, histVNormLBR, 0)
    hPlLow  = ta.valuewhen(histPl, lo_lbr,       0)
    hPhH    = ta.valuewhen(histPh, histVNormLBR, 0)
    hPhHigh = ta.valuewhen(histPh, hi_lbr,       0)
    mPlM    = ta.valuewhen(macdPl, macdVNormLBR, 0)
    mPlLow  = ta.valuewhen(macdPl, lo_lbr,       0)
    mPhM    = ta.valuewhen(macdPh, macdVNormLBR, 0)
    mPhHigh = ta.valuewhen(macdPh, hi_lbr,       0)

    // Potential divergence uses the candidate pivot found inside the left-lookback window, including the current bar.
    rsiPotPlOff   = f_barsAgo(ta.lowestbars(rsiV,      lbLeft + 1))
    rsiPotPhOff   = f_barsAgo(ta.highestbars(rsiV,     lbLeft + 1))
    histPotPlOff  = f_barsAgo(ta.lowestbars(histVNorm, lbLeft + 1))
    histPotPhOff  = f_barsAgo(ta.highestbars(histVNorm, lbLeft + 1))
    macdPotPlOff  = f_barsAgo(ta.lowestbars(macdVNorm, lbLeft + 1))
    macdPotPhOff  = f_barsAgo(ta.highestbars(macdVNorm, lbLeft + 1))
    pricePotPlOff = f_barsAgo(ta.lowestbars(low,       lbLeft + 1))
    pricePotPhOff = f_barsAgo(ta.highestbars(high,     lbLeft + 1))

    rsiPotPl  = rsiPotPlOff == pricePotPlOff
    rsiPotPh  = rsiPotPhOff == pricePotPhOff
    histPotPl = histPotPlOff == pricePotPlOff
    histPotPh = histPotPhOff == pricePotPhOff
    macdPotPl = macdPotPlOff == pricePotPlOff
    macdPotPh = macdPotPhOff == pricePotPhOff

    potRsiVBull  = rsiV[rsiPotPlOff]
    potRsiVBear  = rsiV[rsiPotPhOff]
    potHistVBull = histVNorm[histPotPlOff]
    potHistVBear = histVNorm[histPotPhOff]
    potMacdVBull = macdVNorm[macdPotPlOff]
    potMacdVBear = macdVNorm[macdPotPhOff]
    potLow       = low[pricePotPlOff]
    potHigh      = high[pricePotPhOff]
    potBsRPl     = bsRPl - rsiPotPlOff
    potBsRPh     = bsRPh - rsiPotPhOff
    potBsHPl     = bsHPl - histPotPlOff
    potBsHPh     = bsHPh - histPotPhOff
    potBsMPl     = bsMPl - macdPotPlOff
    potBsMPh     = bsMPh - macdPotPhOff

    // Bull: oscillator higher low — also require it hasn't broken above last confirmed high (still in divergence zone)
    // Bear: oscillator lower high — also require it hasn't broken below last confirmed low (still in divergence zone)
    // hist/MACD comparisons use normalized values to match visual space
    rBull = f_isBullPotValid(rsiPotPl, true, potRsiVBull, lastBullOsc=rPlRsi, lastBullPrice=rPlLow, oppositeBearOsc=rPhRsi, priceValue=potLow, barsSinceBull=potBsRPl, rngLow=rngLow, rngHigh=rngHigh, enforceZone=enforcePotZone)
    rBear = f_isBearPotValid(rsiPotPh, true, potRsiVBear, lastBearOsc=rPhRsi, lastBearPrice=rPhHigh, oppositeBullOsc=rPlRsi, priceValue=potHigh, barsSinceBear=potBsRPh, rngLow=rngLow, rngHigh=rngHigh, enforceZone=enforcePotZone)
    hBull = f_isBullPotValid(histPotPl, true, potHistVBull, lastBullOsc=hPlH, lastBullPrice=hPlLow, oppositeBearOsc=hPhH, priceValue=potLow, barsSinceBull=potBsHPl, rngLow=rngLow, rngHigh=rngHigh, enforceZone=enforcePotZone)
    hBear = f_isBearPotValid(histPotPh, true, potHistVBear, lastBearOsc=hPhH, lastBearPrice=hPhHigh, oppositeBullOsc=hPlH, priceValue=potHigh, barsSinceBear=potBsHPh, rngLow=rngLow, rngHigh=rngHigh, enforceZone=enforcePotZone)
    mBull = f_isBullPotValid(macdPotPl, true, potMacdVBull, lastBullOsc=mPlM, lastBullPrice=mPlLow, oppositeBearOsc=mPhM, priceValue=potLow, barsSinceBull=potBsMPl, rngLow=rngLow, rngHigh=rngHigh, enforceZone=enforcePotZone)
    mBear = f_isBearPotValid(macdPotPh, true, potMacdVBear, lastBearOsc=mPhM, lastBearPrice=mPhHigh, oppositeBullOsc=mPlM, priceValue=potHigh, barsSinceBear=potBsMPh, rngLow=rngLow, rngHigh=rngHigh, enforceZone=enforcePotZone)

    // ── Confirmed divergences (pivot fully formed, compare to prior pivot) ──
    rPlRsiPrev  = ta.valuewhen(rsiPl,  rV_lbr, 1)
    rPlLowPrev  = ta.valuewhen(rsiPl,  lo_lbr, 1)
    rPhRsiPrev  = ta.valuewhen(rsiPh,  rV_lbr, 1)
    rPhHighPrev = ta.valuewhen(rsiPh,  hi_lbr, 1)
    hPlHPrev    = ta.valuewhen(histPl, hV_lbr, 1)
    hPlLowPrev  = ta.valuewhen(histPl, lo_lbr, 1)
    hPhHPrev    = ta.valuewhen(histPh, hV_lbr, 1)
    hPhHighPrev = ta.valuewhen(histPh, hi_lbr, 1)
    mPlMPrev    = ta.valuewhen(macdPl, mV_lbr, 1)
    mPlLowPrev  = ta.valuewhen(macdPl, lo_lbr, 1)
    mPhMPrev    = ta.valuewhen(macdPh, mV_lbr, 1)
    mPhHighPrev = ta.valuewhen(macdPh, hi_lbr, 1)

    // Use [1] index instead of ta.barssince(x[1]) — equivalent and avoids 6 extra barssince calls
    bsRPlP = bsRPl[1]
    bsRPhP = bsRPh[1]
    bsHPlP = bsHPl[1]
    bsHPhP = bsHPh[1]
    bsMPlP = bsMPl[1]
    bsMPhP = bsMPh[1]

    cRBull = rsiPl  and rV_lbr > rPlRsiPrev  and lo_lbr < rPlLowPrev  and bsRPlP >= rngLow and bsRPlP <= rngHigh
    cRBear = rsiPh  and rV_lbr < rPhRsiPrev  and hi_lbr > rPhHighPrev and bsRPhP >= rngLow and bsRPhP <= rngHigh
    cHBull = histPl and hV_lbr > hPlHPrev    and lo_lbr < hPlLowPrev  and bsHPlP >= rngLow and bsHPlP <= rngHigh
    cHBear = histPh and hV_lbr < hPhHPrev    and hi_lbr > hPhHighPrev and bsHPhP >= rngLow and bsHPhP <= rngHigh
    cMBull = macdPl and mV_lbr > mPlMPrev    and lo_lbr < mPlLowPrev  and bsMPlP >= rngLow and bsMPlP <= rngHigh
    cMBear = macdPh and mV_lbr < mPhMPrev    and hi_lbr > mPhHighPrev and bsMPhP >= rngLow and bsMPhP <= rngHigh

    // barssince confirmed — na until first occurrence; used for "N bars ago" display
    cbsRBull = ta.barssince(cRBull)
    cbsRBear = ta.barssince(cRBear)
    cbsHBull = ta.barssince(cHBull)
    cbsHBear = ta.barssince(cHBear)
    cbsMBull = ta.barssince(cMBull)
    cbsMBear = ta.barssince(cMBear)

    // Killed: close breaks the pivot price level that formed the confirmed divergence
    // Bull killed → close < pivot low of that divergence
    // Bear killed → close > pivot high of that divergence
    kRBull = not na(cbsRBull) and cbsRBull <= rngHigh and close < ta.valuewhen(cRBull, lo_lbr, 0)
    kRBear = not na(cbsRBear) and cbsRBear <= rngHigh and close > ta.valuewhen(cRBear, hi_lbr, 0)
    kHBull = not na(cbsHBull) and cbsHBull <= rngHigh and close < ta.valuewhen(cHBull, lo_lbr, 0)
    kHBear = not na(cbsHBear) and cbsHBear <= rngHigh and close > ta.valuewhen(cHBear, hi_lbr, 0)
    kMBull = not na(cbsMBull) and cbsMBull <= rngHigh and close < ta.valuewhen(cMBull, lo_lbr, 0)
    kMBear = not na(cbsMBear) and cbsMBear <= rngHigh and close > ta.valuewhen(cMBear, hi_lbr, 0)

    [rBull, rBear, hBull, hBear, mBull, mBear, cbsRBull, cbsRBear, cbsHBull, cbsHBear, cbsMBull, cbsMBear, kRBull, kRBear, kHBull, kHBear, kMBull, kMBear]

// ─── RSI Divergence Detection ────────────────────────────────────────────────
rsiLBR  = rsi[lookbackRight]
lowLBR  = low[lookbackRight]
highLBR = high[lookbackRight]

rsiPlFound = not na(ta.pivotlow(rsi,  lookbackLeft, lookbackRight))
rsiPhFound = not na(ta.pivothigh(rsi, lookbackLeft, lookbackRight))
// barssince computed once here — reused for both confirmed div range check and potential div
bsRsiPl = ta.barssince(rsiPlFound)
bsRsiPh = ta.barssince(rsiPhFound)

// RSI Bullish: price lower low + RSI higher low
rsiHL      = rsiLBR > ta.valuewhen(rsiPlFound, rsiLBR, 1) and (rangeLower <= bsRsiPl[1] and bsRsiPl[1] <= rangeUpper)
rsiPriceLL = lowLBR  < ta.valuewhen(rsiPlFound, lowLBR,  1)
rsiBull    = rsiPriceLL and rsiHL  and rsiPlFound

// RSI Bearish: price higher high + RSI lower high
rsiLH      = rsiLBR < ta.valuewhen(rsiPhFound, rsiLBR, 1) and (rangeLower <= bsRsiPh[1] and bsRsiPh[1] <= rangeUpper)
rsiPriceHH = highLBR > ta.valuewhen(rsiPhFound, highLBR, 1)
rsiBear    = rsiPriceHH and rsiLH and rsiPhFound

// ─── MACD Histogram Divergence Detection ─────────────────────────────────────
histLBR = hist[lookbackRight]
histNormLBR = histNorm[lookbackRight]

macdPlFound = not na(ta.pivotlow(histNorm,  lookbackLeft, lookbackRight))
macdPhFound = not na(ta.pivothigh(histNorm, lookbackLeft, lookbackRight))
bsMacdPl    = ta.barssince(macdPlFound)
bsMacdPh    = ta.barssince(macdPhFound)

// MACD Bullish: price lower low + histogram higher low
macdHL      = histNormLBR > ta.valuewhen(macdPlFound, histNormLBR, 1) and (rangeLower <= bsMacdPl[1] and bsMacdPl[1] <= rangeUpper)
macdPriceLL = lowLBR  < ta.valuewhen(macdPlFound, lowLBR,  1)
macdBull    = macdPriceLL and macdHL and macdPlFound

// MACD Bearish: price higher high + histogram lower high
macdLH      = histNormLBR < ta.valuewhen(macdPhFound, histNormLBR, 1) and (rangeLower <= bsMacdPh[1] and bsMacdPh[1] <= rangeUpper)
macdPriceHH = highLBR > ta.valuewhen(macdPhFound, highLBR, 1)
macdBear    = macdPriceHH and macdLH and macdPhFound

// ─── MACD Line Divergence Detection ─────────────────────────────────────────
macdLineLBR = macd[lookbackRight]
macdNormLBR = macdNorm[lookbackRight]

macdLinePlFound = not na(ta.pivotlow(macdNorm,  lookbackLeft, lookbackRight))
macdLinePhFound = not na(ta.pivothigh(macdNorm, lookbackLeft, lookbackRight))
bsMacdLinePl    = ta.barssince(macdLinePlFound)
bsMacdLinePh    = ta.barssince(macdLinePhFound)

// MACD Line Bullish: price lower low + MACD line higher low
macdLineHL      = macdNormLBR > ta.valuewhen(macdLinePlFound, macdNormLBR, 1) and (rangeLower <= bsMacdLinePl[1] and bsMacdLinePl[1] <= rangeUpper)
macdLinePriceLL = lowLBR < ta.valuewhen(macdLinePlFound, lowLBR, 1)
macdLineBull    = macdLinePriceLL and macdLineHL and macdLinePlFound

// MACD Line Bearish: price higher high + MACD line lower high
macdLineLH      = macdNormLBR < ta.valuewhen(macdLinePhFound, macdNormLBR, 1) and (rangeLower <= bsMacdLinePh[1] and bsMacdLinePh[1] <= rangeUpper)
macdLinePriceHH = highLBR > ta.valuewhen(macdLinePhFound, highLBR, 1)
macdLineBear    = macdLinePriceHH and macdLineLH and macdLinePhFound

// ─── Potential Divergence Detection (no right-lookback confirmation, repaints) ───────────────────
// A potential pivot fires when the current bar is the lowest/highest over the past lookbackLeft bars
// barssince series already computed above — reused here (zero extra ta.barssince calls)

// Most-recent confirmed pivot values (occurrence 0)
rsiLastPlRsi   = ta.valuewhen(rsiPlFound, rsiLBR,        0)
rsiLastPlLow   = ta.valuewhen(rsiPlFound, lowLBR,         0)
rsiLastPhRsi   = ta.valuewhen(rsiPhFound, rsiLBR,        0)
rsiLastPhHigh  = ta.valuewhen(rsiPhFound, highLBR,        0)
histLastPlHist = ta.valuewhen(macdPlFound, histDispLBR,    0)
histLastPlLow  = ta.valuewhen(macdPlFound, lowLBR,         0)
histLastPhHist = ta.valuewhen(macdPhFound, histDispLBR,    0)
histLastPhHigh = ta.valuewhen(macdPhFound, highLBR,        0)
macdLastPlMacd = ta.valuewhen(macdLinePlFound, macdDispLBR, 0)
macdLastPlLow  = ta.valuewhen(macdLinePlFound, lowLBR,     0)
macdLastPhMacd = ta.valuewhen(macdLinePhFound, macdDispLBR, 0)
macdLastPhHigh = ta.valuewhen(macdLinePhFound, highLBR,    0)

// Start XY of each potential div line (left/older end = most recent confirmed pivot bar)
rsiPotBullX1      = int(ta.valuewhen(rsiPlFound,      bar_index, 0)) - lookbackRight
rsiPotBullY1      = ta.valuewhen(rsiPlFound,      rsiLBR,       0)
rsiPotBearX1      = int(ta.valuewhen(rsiPhFound,      bar_index, 0)) - lookbackRight
rsiPotBearY1      = ta.valuewhen(rsiPhFound,      rsiLBR,       0)
histPotBullX1     = int(ta.valuewhen(macdPlFound,     bar_index, 0)) - lookbackRight
histPotBullY1     = ta.valuewhen(macdPlFound,     histDispLBR,  0)
histPotBearX1     = int(ta.valuewhen(macdPhFound,     bar_index, 0)) - lookbackRight
histPotBearY1     = ta.valuewhen(macdPhFound,     histDispLBR,  0)
macdLinePotBullX1 = int(ta.valuewhen(macdLinePlFound, bar_index, 0)) - lookbackRight
macdLinePotBullY1 = ta.valuewhen(macdLinePlFound, macdDispLBR,  0)
macdLinePotBearX1 = int(ta.valuewhen(macdLinePhFound, bar_index, 0)) - lookbackRight
macdLinePotBearY1 = ta.valuewhen(macdLinePhFound, macdDispLBR,  0)

// Potential divergence uses the candidate pivot found inside the left-lookback window, including the current bar.
// RSI uses raw 0-100; hist and MACD use normalized values to match the visual line endpoints.
rsiPotPlOff   = f_barsAgo(ta.lowestbars(rsi,      lookbackLeft + 1))
rsiPotPhOff   = f_barsAgo(ta.highestbars(rsi,     lookbackLeft + 1))
histPotPlOff  = f_barsAgo(ta.lowestbars(histNorm, lookbackLeft + 1))
histPotPhOff  = f_barsAgo(ta.highestbars(histNorm, lookbackLeft + 1))
macdPotPlOff  = f_barsAgo(ta.lowestbars(macdNorm, lookbackLeft + 1))
macdPotPhOff  = f_barsAgo(ta.highestbars(macdNorm, lookbackLeft + 1))
pricePotPlOff = f_barsAgo(ta.lowestbars(low,      lookbackLeft + 1))
pricePotPhOff = f_barsAgo(ta.highestbars(high,    lookbackLeft + 1))

rsiPotPl   = rsiPotPlOff == pricePotPlOff
rsiPotPh   = rsiPotPhOff == pricePotPhOff
histPotPl  = histPotPlOff == pricePotPlOff
histPotPh  = histPotPhOff == pricePotPhOff
macdPotPl  = macdPotPlOff == pricePotPlOff
macdPotPh  = macdPotPhOff == pricePotPhOff

potRsiBull      = rsi[rsiPotPlOff]
potRsiBear      = rsi[rsiPotPhOff]
potHistNormBull = histNorm[histPotPlOff]
potHistNormBear = histNorm[histPotPhOff]
potMacdNormBull = macdNorm[macdPotPlOff]
potMacdNormBear = macdNorm[macdPotPhOff]
potLow          = low[pricePotPlOff]
potHigh         = high[pricePotPhOff]
potBsRsiPl      = bsRsiPl - rsiPotPlOff
potBsRsiPh      = bsRsiPh - rsiPotPhOff
potBsMacdPl     = bsMacdPl - histPotPlOff
potBsMacdPh     = bsMacdPh - histPotPhOff
potBsMacdLinePl = bsMacdLinePl - macdPotPlOff
potBsMacdLinePh = bsMacdLinePh - macdPotPhOff

// Bull: oscillator higher low — also require it hasn't broken above last confirmed high (still in divergence zone)
// Bear: oscillator lower high — also require it hasn't broken below last confirmed low (still in divergence zone)
// hist and MACD comparisons use normalized values (consistent with visual line endpoints)
rsiPotBull      = f_isBullPotValid(rsiPotPl, true, potRsiBull, lastBullOsc=rsiLastPlRsi, lastBullPrice=rsiLastPlLow, oppositeBearOsc=rsiLastPhRsi, priceValue=potLow, barsSinceBull=potBsRsiPl, rngLow=rangeLower, rngHigh=rangeUpper, enforceZone=enforcePotZone)
rsiPotBear      = f_isBearPotValid(rsiPotPh, true, potRsiBear, lastBearOsc=rsiLastPhRsi, lastBearPrice=rsiLastPhHigh, oppositeBullOsc=rsiLastPlRsi, priceValue=potHigh, barsSinceBear=potBsRsiPh, rngLow=rangeLower, rngHigh=rangeUpper, enforceZone=enforcePotZone)
histPotBull     = f_isBullPotValid(histPotPl, true, potHistNormBull, lastBullOsc=histLastPlHist, lastBullPrice=histLastPlLow, oppositeBearOsc=histLastPhHist, priceValue=potLow, barsSinceBull=potBsMacdPl, rngLow=rangeLower, rngHigh=rangeUpper, enforceZone=enforcePotZone)
histPotBear     = f_isBearPotValid(histPotPh, true, potHistNormBear, lastBearOsc=histLastPhHist, lastBearPrice=histLastPhHigh, oppositeBullOsc=histLastPlHist, priceValue=potHigh, barsSinceBear=potBsMacdPh, rngLow=rangeLower, rngHigh=rangeUpper, enforceZone=enforcePotZone)
macdLinePotBull = f_isBullPotValid(macdPotPl, true, potMacdNormBull, lastBullOsc=macdLastPlMacd, lastBullPrice=macdLastPlLow, oppositeBearOsc=macdLastPhMacd, priceValue=potLow, barsSinceBull=potBsMacdLinePl, rngLow=rangeLower, rngHigh=rangeUpper, enforceZone=enforcePotZone)
macdLinePotBear = f_isBearPotValid(macdPotPh, true, potMacdNormBear, lastBearOsc=macdLastPhMacd, lastBearPrice=macdLastPhHigh, oppositeBullOsc=macdLastPlMacd, priceValue=potHigh, barsSinceBear=potBsMacdLinePh, rngLow=rangeLower, rngHigh=rangeUpper, enforceZone=enforcePotZone)

// ─── Divergence Background Highlight ────────────────────────────────────────
noneColor    = color.new(color.white, 100)
rsiBullColor = color.new(#fbc02d, 50)   // yellow – RSI bullish
rsiBearColor = color.new(#fbc02d, 50)   // yellow – RSI bearish
macdBullColor     = color.new(#ab47bc, 50)  // purple – MACD histogram bullish
macdBearColor     = color.new(#ab47bc, 50)  // purple – MACD histogram bearish
macdLineBullColor = color.new(#26c6da, 50)  // cyan   – MACD line bullish
macdLineBearColor = color.new(#26c6da, 50)  // cyan   – MACD line bearish

// ─── Plot order: Signal (back) → Histogram → MACD line → RSI (front/top) ────

// RSI hlines (always behind plots)
rsiUpperBand = hline(obLevel, "Overbought", color=color.new(#787B86, 80), linestyle=hline.style_dashed)
rsiLowerBand = hline(osLevel, "Oversold",   color=color.new(#787B86, 80), linestyle=hline.style_dashed)
fill(rsiUpperBand, rsiLowerBand, color=color.rgb(126, 87, 194, 95), title="RSI Background Fill")

// Signal line — back (hidden by default, toggle in Style settings)
plot(signalNorm, "Signal Line", color=color.new(color.orange, 0), linewidth=1, display=display.none)

// Histogram fills — fill-based, centered on 50 (histNorm: hist=0 → 50)
histPosCl    = hist > hist[1] ? color.new(#26a69a, 80) : color.new(#b2dfdb, 80)
histNegCl    = hist > hist[1] ? color.new(#ffcdd2, 80) : color.new(#ff5252, 80)
histNormPos  = hist >= 0 ? histNorm : 50.0
histNormNeg  = hist <  0 ? histNorm : 50.0
histPosPlot  = plot(histNormPos, "Hist+",     color=na, display=display.none)
histNegPlot  = plot(histNormNeg, "Hist-",     color=na, display=display.none)
histBasePlot = plot(50,          "Hist Base", color=na, display=display.none, editable=false)
fill(histPosPlot, histBasePlot, color=histPosCl, title="Histogram Positive Fill")
fill(histNegPlot, histBasePlot, color=histNegCl, title="Histogram Negative Fill")

// MACD line — middle
plot(macdNorm, "MACD", color=#26c6da)

// RSI line
plot(rsi, "RSI", color=#fbc02d)

// ─── RSI Divergence Plots ────────────────────────────────────────────────────
plot(
     rsiPlFound ? rsiLBR : na,
     offset    = -lookbackRight,
     title     = "RSI Bullish Divergence Line",
     color     = rsiBull ? rsiBullColor : noneColor,
     display   = display.pane)

plotshape(
     rsiBull ? rsiLBR : na,
     offset    = -lookbackRight,
     title     = "RSI Bull Triangle",
     style     = shape.triangleup,
     location  = location.absolute,
     color     = rsiBullColor,
     size      = size.small,
     display   = display.pane)

plotshape(
     rsiBull and showDivLabels ? rsiLBR : na,
     offset    = -lookbackRight,
     title     = "RSI Bullish Label",
     text      = " RSI Bull ",
     style     = shape.labelup,
     location  = location.absolute,
     color     = rsiBullColor,
     textcolor = color.white,
     size      = size.small,
     display   = display.pane)

plot(
     rsiPhFound ? rsiLBR : na,
     offset    = -lookbackRight,
     title     = "RSI Bearish Divergence Line",
     color     = rsiBear ? rsiBearColor : noneColor,
     display   = display.pane)

plotshape(
     rsiBear ? rsiLBR : na,
     offset    = -lookbackRight,
     title     = "RSI Bear Triangle",
     style     = shape.triangledown,
     location  = location.absolute,
     color     = rsiBearColor,
     size      = size.small,
     display   = display.pane)

plotshape(
     rsiBear and showDivLabels ? rsiLBR : na,
     offset    = -lookbackRight,
     title     = "RSI Bearish Label",
     text      = " RSI Bear ",
     style     = shape.labeldown,
     location  = location.absolute,
     color     = rsiBearColor,
     textcolor = color.white,
     size      = size.small,
     display   = display.pane)

// ─── MACD Divergence Plots ───────────────────────────────────────────────────
plot(
     macdPlFound ? histDispLBR : na,
     offset    = -lookbackRight,
     title     = "MACD Bullish Divergence Line",
     color     = macdBull ? macdBullColor : noneColor,
     display   = display.pane)

plotshape(
     macdBull ? histDispLBR : na,
     offset    = -lookbackRight,
     title     = "MACD Hist Bull Triangle",
