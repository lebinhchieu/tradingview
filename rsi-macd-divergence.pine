//@version=6
indicator(title="RSI + MACD Divergence", shorttitle="RSI+MACD Div", format=format.price, precision=2)

// ─── RSI Settings ────────────────────────────────────────────────────────────
rsiLengthInput = input.int(14,  "RSI Length", minval=1,  group="RSI Settings")
rsiSourceInput = input.source(close, "Source",           group="RSI Settings")
obLevel        = input.int(70, "Overbought Level",       group="RSI Settings")
osLevel        = input.int(30, "Oversold Level",         group="RSI Settings")

// ─── MACD Settings ───────────────────────────────────────────────────────────
macdSourceInput = input.source(close, "Source",          group="MACD Settings")
fastLenInput    = input.int(12, "Fast Length",  minval=1, group="MACD Settings")
slowLenInput    = input.int(26, "Slow Length",  minval=1, group="MACD Settings")
sigLenInput     = input.int(9,  "Signal Length", minval=1, group="MACD Settings")
normPeriod      = input.int(200, "Norm Lookback Period", minval=20, group="MACD Settings")

// ─── Divergence Settings ─────────────────────────────────────────────────────
lookbackRight  = input.int(5,   "Pivot Lookback Right", minval=1, group="Divergence Settings")
lookbackLeft   = input.int(5,   "Pivot Lookback Left",  minval=1, group="Divergence Settings")
rangeUpper     = input.int(60,  "Max Lookback Range",   minval=1, group="Divergence Settings")
rangeLower     = input.int(5,   "Min Lookback Range",   minval=1, group="Divergence Settings")
showDivLabels  = input.bool(false, "Show Divergence Labels", group="Divergence Settings")
enforcePotZone = input.bool(true, "Potential: Enforce Opposite Pivot Zone", group="Divergence Settings")

// ─── MTF Table Settings ──────────────────────────────────────────────────────
tableMaxBars = input.int(30, "Table Conf/Kill Max Bars", minval=1, group="MTF Table Settings", tooltip="Only show confirmed/killed divergences within this many bars")
tablePos = input.string("top_left", "Table Position",
     options=["top_left","top_right","bottom_left","bottom_right","top_center","bottom_center"],
     group="MTF Table Settings")
colorThresh1 = input.int(5,  "Color Darken Threshold 1", minval=1, group="MTF Table Settings", tooltip="Bars since signal: up to this value uses brightest color")
colorThresh2 = input.int(10, "Color Darken Threshold 2", minval=1, group="MTF Table Settings", tooltip="Bars since signal: up to this value uses medium color; above uses darkest")
show1m   = input.bool(true,  "1m",  inline="tfs", group="MTF Table Settings")
show5m   = input.bool(true,  "5m",  inline="tfs", group="MTF Table Settings")
show15m  = input.bool(true,  "15m", inline="tfs", group="MTF Table Settings")
show1h   = input.bool(true,  "1h",  inline="tfs", group="MTF Table Settings")
show4h   = input.bool(true,  "4h",  inline="tfs", group="MTF Table Settings")

// ─── RSI Calculation ─────────────────────────────────────────────────────────
rsiChange = ta.change(rsiSourceInput)
rsiUp     = ta.rma(math.max(rsiChange, 0), rsiLengthInput)
rsiDown   = ta.rma(-math.min(rsiChange, 0), rsiLengthInput)
rsi       = rsiDown == 0 ? 100 : rsiUp == 0 ? 0 : 100 - (100 / (1 + rsiUp / rsiDown))

// ─── MACD Calculation ────────────────────────────────────────────────────────
maFast = ta.ema(macdSourceInput, fastLenInput)
maSlow = ta.ema(macdSourceInput, slowLenInput)
macd   = maFast - maSlow
signal = ta.ema(macd, sigLenInput)
hist   = macd - signal

// ─── MACD Normalization — scale relative to prior-period range (values may exceed 0-100) ───
macdHigh   = ta.highest(macd[1],   normPeriod)
macdLow    = ta.lowest(macd[1],    normPeriod)
sigHigh    = ta.highest(signal[1], normPeriod)
sigLow     = ta.lowest(signal[1],  normPeriod)
macdNorm   = macdHigh != macdLow ? (macd   - macdLow) / (macdHigh - macdLow) * 60 + 20 : 50.0
signalNorm = sigHigh  != sigLow  ? (signal - sigLow)  / (sigHigh  - sigLow)  * 60 + 20 : 50.0
histAbsMax = math.max(math.abs(ta.highest(hist[1], normPeriod)), math.abs(ta.lowest(hist[1], normPeriod)))
histNorm   = histAbsMax != 0.0 ? hist / histAbsMax * 30 + 50 : 50.0

// Display lookback values — normalized, ready to plot directly (no +50 needed)
histDispLBR = histNorm[lookbackRight]
macdDispLBR = macdNorm[lookbackRight]

f_isInRange(barsSince, rngLow, rngHigh) =>
    not na(barsSince) and barsSince >= rngLow and barsSince <= rngHigh

f_barsAgo(offset) =>
    math.max(0, -int(offset))

f_isBullPotValid(oscPivot, pricePivot, oscValue, lastBullOsc, lastBullPrice, oppositeBearOsc, priceValue, barsSinceBull, rngLow, rngHigh, enforceZone) =>
    hasBullRef = not na(lastBullOsc) and not na(lastBullPrice)
    withinZone = not enforceZone or na(oppositeBearOsc) or oscValue < oppositeBearOsc
    oscPivot and pricePivot and hasBullRef and oscValue > lastBullOsc and withinZone and priceValue < lastBullPrice and f_isInRange(barsSinceBull, rngLow, rngHigh)

f_isBearPotValid(oscPivot, pricePivot, oscValue, lastBearOsc, lastBearPrice, oppositeBullOsc, priceValue, barsSinceBear, rngLow, rngHigh, enforceZone) =>
    hasBearRef = not na(lastBearOsc) and not na(lastBearPrice)
    withinZone = not enforceZone or na(oppositeBullOsc) or oscValue > oppositeBullOsc
    oscPivot and pricePivot and hasBearRef and oscValue < lastBearOsc and withinZone and priceValue > lastBearPrice and f_isInRange(barsSinceBear, rngLow, rngHigh)

f_divergenceState(oscRaw, oscDisp, lbLeft, lbRight, rngLow, rngHigh, enforceZone) =>
    plFound = not na(ta.pivotlow(oscRaw,  lbLeft, lbRight))
    phFound = not na(ta.pivothigh(oscRaw, lbLeft, lbRight))
    bsPl = ta.barssince(plFound)
    bsPh = ta.barssince(phFound)

    oscLBR  = oscRaw[lbRight]
    dispLBR = oscDisp[lbRight]
    lowLBR  = low[lbRight]
    highLBR = high[lbRight]

    lastPlOsc   = ta.valuewhen(plFound, oscLBR,  0)
    lastPlPrice = ta.valuewhen(plFound, lowLBR,  0)
    lastPhOsc   = ta.valuewhen(phFound, oscLBR,  0)
    lastPhPrice = ta.valuewhen(phFound, highLBR, 0)

    prevPlOsc   = ta.valuewhen(plFound, oscLBR,  1)
    prevPlPrice = ta.valuewhen(plFound, lowLBR,  1)
    prevPhOsc   = ta.valuewhen(phFound, oscLBR,  1)
    prevPhPrice = ta.valuewhen(phFound, highLBR, 1)

    bull = plFound and oscLBR > prevPlOsc and lowLBR < prevPlPrice and f_isInRange(bsPl[1], rngLow, rngHigh)
    bear = phFound and oscLBR < prevPhOsc and highLBR > prevPhPrice and f_isInRange(bsPh[1], rngLow, rngHigh)

    cbsBull = ta.barssince(bull)
    cbsBear = ta.barssince(bear)
    // Latched kill: once price breaks the pivot level, stays killed until a new confirmed divergence resets it
    var bool _killBullLatched = false
    var bool _killBearLatched = false
    if bull
        _killBullLatched := false
    if bear
        _killBearLatched := false
    bullPivotLevel = ta.valuewhen(bull, lowLBR, 0)
    bearPivotLevel = ta.valuewhen(bear, highLBR, 0)
    if not na(cbsBull) and cbsBull <= rngHigh and close < bullPivotLevel
        _killBullLatched := true
    if not na(cbsBear) and cbsBear <= rngHigh and close > bearPivotLevel
        _killBearLatched := true
    killBull = _killBullLatched and not na(cbsBull) and cbsBull <= rngHigh
    killBear = _killBearLatched and not na(cbsBear) and cbsBear <= rngHigh

    // Search for potential pivot extremes starting from bar 1 (exclude current bar — it's still forming)
    potBullOff = f_barsAgo(ta.lowestbars(oscRaw[1],  lbLeft)) + 1
    potBearOff = f_barsAgo(ta.highestbars(oscRaw[1], lbLeft)) + 1
    potBullOsc = oscRaw[potBullOff]
    potBearOsc = oscRaw[potBearOff]
    potBullDisp = oscDisp[potBullOff]
    potBearDisp = oscDisp[potBearOff]
    potBullPrice = low[potBullOff]
    potBearPrice = high[potBearOff]
    // Distance from actual confirmed pivot bar (bsPl + lbRight ago) to potential pivot bar (potBullOff ago)
    potBsBull = bsPl + lbRight - potBullOff
    potBsBear = bsPh + lbRight - potBearOff

    // Price local-extreme: require price extreme within 2 bars of oscillator extreme
    potPriceLowOff  = f_barsAgo(ta.lowestbars(low[1],  lbLeft)) + 1
    potPriceHighOff = f_barsAgo(ta.highestbars(high[1], lbLeft)) + 1
    potBullPriceExtreme = math.abs(potBullOff - potPriceLowOff) <= 2
    potBearPriceExtreme = math.abs(potBearOff - potPriceHighOff) <= 2

    potBull = potBullOff < lbRight and potBullPriceExtreme and f_isBullPotValid(true, true, potBullOsc, lastPlOsc, lastPlPrice, lastPhOsc, potBullPrice, potBsBull, rngLow, rngHigh, enforceZone)
    potBear = potBearOff < lbRight and potBearPriceExtreme and f_isBearPotValid(true, true, potBearOsc, lastPhOsc, lastPhPrice, lastPlOsc, potBearPrice, potBsBear, rngLow, rngHigh, enforceZone)

    [plFound, phFound, bull, bear, potBull, potBear, cbsBull, cbsBear, killBull, killBear, potBullOff, potBearOff, potBullDisp, potBearDisp]

// ─── MTF Potential Divergence Function (uses close/low/high from requested TF) ─
f_potDiv(rsiLen, fast, slow, sig, lbLeft, lbRight, rngLow, rngHigh) =>
    rsiChg  = ta.change(close)
    rUp     = ta.rma(math.max(rsiChg, 0), rsiLen)
    rDn     = ta.rma(-math.min(rsiChg, 0), rsiLen)
    rsiV    = rDn == 0 ? 100 : rUp == 0 ? 0 : 100 - (100 / (1 + rUp / rDn))
    mFast   = ta.ema(close, fast)
    mSlow   = ta.ema(close, slow)
    macdV   = mFast - mSlow
    sigV    = ta.ema(macdV, sig)
    histV   = macdV - sigV
    mCrossUp   = ta.crossover(macdV, sigV)
    mCrossDown = ta.crossunder(macdV, sigV)

    // Normalize MACD and histogram first so confirmed pivots match the displayed series.
    macdVHigh    = ta.highest(macdV[1], normPeriod)
    macdVLow     = ta.lowest(macdV[1],  normPeriod)
    macdVNorm    = macdVHigh != macdVLow ? (macdV - macdVLow) / (macdVHigh - macdVLow) * 60 + 20 : 50.0
    histVAbsMax  = math.max(math.abs(ta.highest(histV[1], normPeriod)), math.abs(ta.lowest(histV[1], normPeriod)))
    histVNorm    = histVAbsMax != 0.0 ? histV / histVAbsMax * 30 + 50 : 50.0

    [_, _, _, _, rBull, rBear, cbsRBull, cbsRBear, kRBull, kRBear, _, _, _, _] =
       f_divergenceState(rsiV, rsiV, lbLeft, lbRight, rngLow, rngHigh, enforcePotZone)
    [_, _, _, _, hBull, hBear, cbsHBull, cbsHBear, kHBull, kHBear, _, _, _, _] =
       f_divergenceState(histV, histVNorm, lbLeft, lbRight, rngLow, rngHigh, enforcePotZone)
    [_, _, _, _, mBull, mBear, cbsMBull, cbsMBear, kMBull, kMBear, _, _, _, _] =
       f_divergenceState(macdV, macdVNorm, lbLeft, lbRight, rngLow, rngHigh, enforcePotZone)

    [rBull, rBear, hBull, hBear, mBull, mBear, cbsRBull, cbsRBear, cbsHBull, cbsHBear, cbsMBull, cbsMBear, kRBull, kRBear, kHBull, kHBear, kMBull, kMBear, mCrossUp, mCrossDown]

// ─── Divergence State Detection ─────────────────────────────────────────────
rsiLBR  = rsi[lookbackRight]
lowLBR  = low[lookbackRight]
highLBR = high[lookbackRight]
histNormLBR = histNorm[lookbackRight]
macdNormLBR = macdNorm[lookbackRight]

[rsiPlFound, rsiPhFound, rsiBull, rsiBear, rsiPotBull, rsiPotBear, rsiCbsBull, rsiCbsBear, rsiKillBull, rsiKillBear, rsiPotPlOff, rsiPotPhOff, potRsiBull, potRsiBear] =
   f_divergenceState(rsi, rsi, lookbackLeft, lookbackRight, rangeLower, rangeUpper, enforcePotZone)
[macdPlFound, macdPhFound, macdBull, macdBear, histPotBull, histPotBear, macdCbsBull, macdCbsBear, macdKillBull, macdKillBear, histPotPlOff, histPotPhOff, potHistNormBull, potHistNormBear] =
   f_divergenceState(hist, histNorm, lookbackLeft, lookbackRight, rangeLower, rangeUpper, enforcePotZone)
[macdLinePlFound, macdLinePhFound, macdLineBull, macdLineBear, macdLinePotBull, macdLinePotBear, macdLineCbsBull, macdLineCbsBear, macdLineKillBull, macdLineKillBear, macdPotPlOff, macdPotPhOff, potMacdNormBull, potMacdNormBear] =
   f_divergenceState(macd, macdNorm, lookbackLeft, lookbackRight, rangeLower, rangeUpper, enforcePotZone)

// Start XY of each potential div line (left/older end = most recent confirmed pivot bar)
rsiPotBullX1      = int(ta.valuewhen(rsiPlFound,      bar_index, 0)) - lookbackRight
rsiPotBullY1      = ta.valuewhen(rsiPlFound,      rsiLBR,       0)
rsiPotBearX1      = int(ta.valuewhen(rsiPhFound,      bar_index, 0)) - lookbackRight
rsiPotBearY1      = ta.valuewhen(rsiPhFound,      rsiLBR,       0)
histPotBullX1     = int(ta.valuewhen(macdPlFound,     bar_index, 0)) - lookbackRight
histPotBullY1     = ta.valuewhen(macdPlFound,     histDispLBR,  0)
histPotBearX1     = int(ta.valuewhen(macdPhFound,     bar_index, 0)) - lookbackRight
histPotBearY1     = ta.valuewhen(macdPhFound,     histDispLBR,  0)
macdLinePotBullX1 = int(ta.valuewhen(macdLinePlFound, bar_index, 0)) - lookbackRight
macdLinePotBullY1 = ta.valuewhen(macdLinePlFound, macdDispLBR,  0)
macdLinePotBearX1 = int(ta.valuewhen(macdLinePhFound, bar_index, 0)) - lookbackRight
macdLinePotBearY1 = ta.valuewhen(macdLinePhFound, macdDispLBR,  0)

// ─── Divergence Background Highlight ────────────────────────────────────────
noneColor    = color.new(color.white, 100)
rsiBullColor = color.new(#fbc02d, 50)   // yellow – RSI bullish
rsiBearColor = color.new(#fbc02d, 50)   // yellow – RSI bearish
macdBullColor     = color.new(#ab47bc, 50)  // purple – MACD histogram bullish
macdBearColor     = color.new(#ab47bc, 50)  // purple – MACD histogram bearish
macdLineBullColor = color.new(#26c6da, 50)  // cyan   – MACD line bullish
macdLineBearColor = color.new(#26c6da, 50)  // cyan   – MACD line bearish

// ─── Plot order: Signal (back) → Histogram → MACD line → RSI (front/top) ────

// RSI hlines (always behind plots)
rsiUpperBand = hline(obLevel, "Overbought", color=color.new(#787B86, 80), linestyle=hline.style_dashed)
rsiLowerBand = hline(osLevel, "Oversold",   color=color.new(#787B86, 80), linestyle=hline.style_dashed)
fill(rsiUpperBand, rsiLowerBand, color=color.rgb(126, 87, 194, 95), title="RSI Background Fill")

// Signal line — back (hidden by default, toggle in Style settings)
plot(signalNorm, "Signal Line", color=color.new(color.orange, 0), linewidth=1, display=display.none)

// Histogram fills — fill-based, centered on 50 (histNorm: hist=0 → 50)
histPosCl    = hist > hist[1] ? color.new(#26a69a, 80) : color.new(#b2dfdb, 80)
histNegCl    = hist > hist[1] ? color.new(#ffcdd2, 80) : color.new(#ff5252, 80)
histNormPos  = hist >= 0 ? histNorm : 50.0
histNormNeg  = hist <  0 ? histNorm : 50.0
histPosPlot  = plot(histNormPos, "Hist+",     color=na, display=display.none)
histNegPlot  = plot(histNormNeg, "Hist-",     color=na, display=display.none)
histBasePlot = plot(50,          "Hist Base", color=na, display=display.none, editable=false)
fill(histPosPlot, histBasePlot, color=histPosCl, title="Histogram Positive Fill")
fill(histNegPlot, histBasePlot, color=histNegCl, title="Histogram Negative Fill")

// MACD line — middle
plot(macdNorm, "MACD", color=#26c6da)

// RSI line
plot(rsi, "RSI", color=#fbc02d)

// ─── RSI Divergence Plots ────────────────────────────────────────────────────
plot(
     rsiPlFound ? rsiLBR : na,
     offset    = -lookbackRight,
     title     = "RSI Bullish Divergence Line",
     color     = rsiBull ? rsiBullColor : noneColor,
     display   = display.pane)

plotshape(
     rsiBull ? rsiLBR : na,
     offset    = -lookbackRight,
     title     = "RSI Bull Triangle",
     style     = shape.triangleup,
     location  = location.absolute,
     color     = rsiBullColor,
     size      = size.small,
     display   = display.pane)

plotshape(
     rsiBull and showDivLabels ? rsiLBR : na,
     offset    = -lookbackRight,
     title     = "RSI Bullish Label",
     text      = " RSI Bull ",
     style     = shape.labelup,
     location  = location.absolute,
     color     = rsiBullColor,
     textcolor = color.white,
     size      = size.small,
     display   = display.pane)

plot(
     rsiPhFound ? rsiLBR : na,
     offset    = -lookbackRight,
     title     = "RSI Bearish Divergence Line",
     color     = rsiBear ? rsiBearColor : noneColor,
     display   = display.pane)

plotshape(
     rsiBear ? rsiLBR : na,
     offset    = -lookbackRight,
     title     = "RSI Bear Triangle",
     style     = shape.triangledown,
     location  = location.absolute,
     color     = rsiBearColor,
     size      = size.small,
     display   = display.pane)

plotshape(
     rsiBear and showDivLabels ? rsiLBR : na,
     offset    = -lookbackRight,
     title     = "RSI Bearish Label",
     text      = " RSI Bear ",
     style     = shape.labeldown,
     location  = location.absolute,
     color     = rsiBearColor,
     textcolor = color.white,
     size      = size.small,
     display   = display.pane)

// ─── MACD Divergence Plots ───────────────────────────────────────────────────
plot(
     macdPlFound ? histDispLBR : na,
     offset    = -lookbackRight,
     title     = "MACD Bullish Divergence Line",
     color     = macdBull ? macdBullColor : noneColor,
     display   = display.pane)

plotshape(
     macdBull ? histDispLBR : na,
     offset    = -lookbackRight,
     title     = "MACD Hist Bull Triangle",
     style     = shape.triangleup,
     location  = location.absolute,
     color     = macdBullColor,
     size      = size.small,
     display   = display.pane)

plotshape(
     macdBull and showDivLabels ? histDispLBR : na,
     offset    = -lookbackRight,
     title     = "MACD Bullish Label",
     text      = " MACD Bull ",
     style     = shape.labelup,
     location  = location.absolute,
     color     = macdBullColor,
     textcolor = color.white,
     size      = size.small,
     display   = display.pane)

plot(
     macdPhFound ? histDispLBR : na,
     offset    = -lookbackRight,
     title     = "MACD Bearish Divergence Line",
     color     = macdBear ? macdBearColor : noneColor,
     display   = display.pane)

plotshape(
     macdBear ? histDispLBR : na,
     offset    = -lookbackRight,
     title     = "MACD Hist Bear Triangle",
     style     = shape.triangledown,
     location  = location.absolute,
     color     = macdBearColor,
     size      = size.small,
     display   = display.pane)

plotshape(
     macdBear and showDivLabels ? histDispLBR : na,
     offset    = -lookbackRight,
     title     = "MACD Bearish Label",
     text      = " MACD Bear ",
     style     = shape.labeldown,
     location  = location.absolute,
     color     = macdBearColor,
     textcolor = color.white,
     size      = size.small,
     display   = display.pane)

// ─── MACD Line Divergence Plots ─────────────────────────────────────────────
plot(
     macdLinePlFound ? macdDispLBR : na,
     offset    = -lookbackRight,
     title     = "MACD Line Bullish Divergence",
     color     = macdLineBull ? macdLineBullColor : noneColor,
     display   = display.pane)

plotshape(
     macdLineBull ? macdDispLBR : na,
     offset    = -lookbackRight,
     title     = "MACD Line Bull Triangle",
     style     = shape.triangleup,
     location  = location.absolute,
     color     = macdLineBullColor,
     size      = size.small,
     display   = display.pane)

plotshape(
     macdLineBull and showDivLabels ? macdDispLBR : na,
     offset    = -lookbackRight,
     title     = "MACD Line Bullish Label",
     text      = " MACD-L Bull ",
     style     = shape.labelup,
     location  = location.absolute,
     color     = macdLineBullColor,
     textcolor = color.white,
     size      = size.small,
     display   = display.pane)

plot(
     macdLinePhFound ? macdDispLBR : na,
     offset    = -lookbackRight,
     title     = "MACD Line Bearish Divergence",
     color     = macdLineBear ? macdLineBearColor : noneColor,
     display   = display.pane)

plotshape(
     macdLineBear ? macdDispLBR : na,
     offset    = -lookbackRight,
     title     = "MACD Line Bear Triangle",
     style     = shape.triangledown,
     location  = location.absolute,
     color     = macdLineBearColor,
     size      = size.small,
     display   = display.pane)

plotshape(
     macdLineBear and showDivLabels ? macdDispLBR : na,
     offset    = -lookbackRight,
     title     = "MACD Line Bearish Label",
     text      = " MACD-L Bear ",
     style     = shape.labeldown,
     location  = location.absolute,
     color     = macdLineBearColor,
     textcolor = color.white,
     size      = size.small,
     display   = display.pane)

// ─── Potential Divergence Lines (dashed, linewidth=2, same color as confirmed) ──────────────────
var line rsiPotBullLine     = na
var line rsiPotBearLine     = na
var line histPotBullLine    = na
var line histPotBearLine    = na
var line macdLinePotBullLine = na
var line macdLinePotBearLine = na

if rsiPotBull
    if na(rsiPotBullLine)
        rsiPotBullLine := line.new(rsiPotBullX1, rsiPotBullY1, bar_index - rsiPotPlOff, potRsiBull, color=rsiBullColor, style=line.style_dashed, width=2)
    else
        line.set_xy1(rsiPotBullLine, rsiPotBullX1, rsiPotBullY1)
        line.set_xy2(rsiPotBullLine, bar_index - rsiPotPlOff, potRsiBull)
else if not na(rsiPotBullLine)
    line.delete(rsiPotBullLine)
    rsiPotBullLine := na

if rsiPotBear
    if na(rsiPotBearLine)
        rsiPotBearLine := line.new(rsiPotBearX1, rsiPotBearY1, bar_index - rsiPotPhOff, potRsiBear, color=rsiBearColor, style=line.style_dashed, width=2)
    else
        line.set_xy1(rsiPotBearLine, rsiPotBearX1, rsiPotBearY1)
        line.set_xy2(rsiPotBearLine, bar_index - rsiPotPhOff, potRsiBear)
else if not na(rsiPotBearLine)
    line.delete(rsiPotBearLine)
    rsiPotBearLine := na

if histPotBull
    if na(histPotBullLine)
        histPotBullLine := line.new(histPotBullX1, histPotBullY1, bar_index - histPotPlOff, potHistNormBull, color=macdBullColor, style=line.style_dashed, width=2)
    else
        line.set_xy1(histPotBullLine, histPotBullX1, histPotBullY1)
        line.set_xy2(histPotBullLine, bar_index - histPotPlOff, potHistNormBull)
else if not na(histPotBullLine)
    line.delete(histPotBullLine)
    histPotBullLine := na

if histPotBear
    if na(histPotBearLine)
        histPotBearLine := line.new(histPotBearX1, histPotBearY1, bar_index - histPotPhOff, potHistNormBear, color=macdBearColor, style=line.style_dashed, width=2)
    else
        line.set_xy1(histPotBearLine, histPotBearX1, histPotBearY1)
        line.set_xy2(histPotBearLine, bar_index - histPotPhOff, potHistNormBear)
else if not na(histPotBearLine)
    line.delete(histPotBearLine)
    histPotBearLine := na

if macdLinePotBull
    if na(macdLinePotBullLine)
        macdLinePotBullLine := line.new(macdLinePotBullX1, macdLinePotBullY1, bar_index - macdPotPlOff, potMacdNormBull, color=macdLineBullColor, style=line.style_dashed, width=2)
    else
        line.set_xy1(macdLinePotBullLine, macdLinePotBullX1, macdLinePotBullY1)
        line.set_xy2(macdLinePotBullLine, bar_index - macdPotPlOff, potMacdNormBull)
else if not na(macdLinePotBullLine)
    line.delete(macdLinePotBullLine)
    macdLinePotBullLine := na

if macdLinePotBear
    if na(macdLinePotBearLine)
        macdLinePotBearLine := line.new(macdLinePotBearX1, macdLinePotBearY1, bar_index - macdPotPhOff, potMacdNormBear, color=macdLineBearColor, style=line.style_dashed, width=2)
    else
        line.set_xy1(macdLinePotBearLine, macdLinePotBearX1, macdLinePotBearY1)
        line.set_xy2(macdLinePotBearLine, bar_index - macdPotPhOff, potMacdNormBear)
else if not na(macdLinePotBearLine)
    line.delete(macdLinePotBearLine)
    macdLinePotBearLine := na

// ─── MACD × Signal Crossover Background ─────────────────────────────────────
macdCrossUp   = ta.crossover(macd,  signal)
macdCrossDown = ta.crossunder(macd, signal)
bgcolor(macdCrossUp   ? color.new(color.green, 90) : na, title="MACD Cross Up BG")
bgcolor(macdCrossDown ? color.new(color.red,   90) : na, title="MACD Cross Down BG")

// ─── MTF Potential Divergence — Security Calls ───────────────────────────────
[r1m_rb,  r1m_rB,  r1m_hb,  r1m_hB,  r1m_mb,  r1m_mB,  r1m_crb, r1m_crB, r1m_chb, r1m_chB, r1m_cmb, r1m_cmB, r1m_krb, r1m_krB, r1m_khb, r1m_khB, r1m_kmb, r1m_kmB, r1m_cu, r1m_cd]  =
     request.security(syminfo.tickerid, "1",   f_potDiv(rsiLengthInput, fastLenInput, slowLenInput, sigLenInput, lookbackLeft, lookbackRight, rangeLower, rangeUpper))
[r5m_rb,  r5m_rB,  r5m_hb,  r5m_hB,  r5m_mb,  r5m_mB,  r5m_crb, r5m_crB, r5m_chb, r5m_chB, r5m_cmb, r5m_cmB, r5m_krb, r5m_krB, r5m_khb, r5m_khB, r5m_kmb, r5m_kmB, r5m_cu, r5m_cd]  =
     request.security(syminfo.tickerid, "5",   f_potDiv(rsiLengthInput, fastLenInput, slowLenInput, sigLenInput, lookbackLeft, lookbackRight, rangeLower, rangeUpper))
[r15m_rb, r15m_rB, r15m_hb, r15m_hB, r15m_mb, r15m_mB, r15m_crb, r15m_crB, r15m_chb, r15m_chB, r15m_cmb, r15m_cmB, r15m_krb, r15m_krB, r15m_khb, r15m_khB, r15m_kmb, r15m_kmB, r15m_cu, r15m_cd] =
     request.security(syminfo.tickerid, "15",  f_potDiv(rsiLengthInput, fastLenInput, slowLenInput, sigLenInput, lookbackLeft, lookbackRight, rangeLower, rangeUpper))
[r1h_rb,  r1h_rB,  r1h_hb,  r1h_hB,  r1h_mb,  r1h_mB,  r1h_crb, r1h_crB, r1h_chb, r1h_chB, r1h_cmb, r1h_cmB, r1h_krb, r1h_krB, r1h_khb, r1h_khB, r1h_kmb, r1h_kmB, r1h_cu, r1h_cd]  =
     request.security(syminfo.tickerid, "60",  f_potDiv(rsiLengthInput, fastLenInput, slowLenInput, sigLenInput, lookbackLeft, lookbackRight, rangeLower, rangeUpper))
[r4h_rb,  r4h_rB,  r4h_hb,  r4h_hB,  r4h_mb,  r4h_mB,  r4h_crb, r4h_crB, r4h_chb, r4h_chB, r4h_cmb, r4h_cmB, r4h_krb, r4h_krB, r4h_khb, r4h_khB, r4h_kmb, r4h_kmB, r4h_cu, r4h_cd]  =
     request.security(syminfo.tickerid, "240", f_potDiv(rsiLengthInput, fastLenInput, slowLenInput, sigLenInput, lookbackLeft, lookbackRight, rangeLower, rangeUpper))

// ─── MTF Table — feed style, only active signals ─────────────────────────────
mtfHdrBg  = color.new(#1e222d, 0)
mtfTfBg   = color.new(#1e222d, 0)
mtfBullBg = color.new(#089981, 0)  // brightest green — used for Potential (P col)
mtfBearBg = color.new(#f23645, 0)  // brightest red   — used for Potential (P col)
mtfBothBg = color.new(#FF7F00, 10)
mtfTxtCl  = color.white
mtfHdrCl  = color.white

// Age-based color: brightest when recent, darkest when old
// Green shades: #089981 → #067a67 → #045a4d
// Red   shades: #f23645 → #c22a37 → #921e29
age_color(isBull, bars) =>
    color result = na
    if isBull
        result := bars <= colorThresh1 ? #089981
               : bars <= colorThresh2 ? #067a67
               : #045a4d
    else
        result := bars <= colorThresh1 ? #f23645
               : bars <= colorThresh2 ? #c22a37
               : #921e29
    result

// Helper: build confirmed and killed div strings, sorted descending by barssince
// krb/krB/etc = kill flags (bool): true if the confirmed div's pivot level has been broken
f_confStr(crb, crB, chb, chB, cmb, cmB, krb, krB, khb, khB, kmb, kmB) =>
    // Active confirmed (not killed)
    clbls = array.new_string()
    cvals = array.new_int()
    cHasBull = false
    cHasBear = false
    // Killed confirmed
    klbls = array.new_string()
    kvals = array.new_int()
    kHasBull = false
    kHasBear = false
    // RSI bull
    if not na(crb) and crb <= tableMaxBars
        if krb
            array.push(klbls, "R▲")
            array.push(kvals, int(crb))
            kHasBull := true
        else
            array.push(clbls, "R▲")
            array.push(cvals, int(crb))
            cHasBull := true
    // RSI bear
    if not na(crB) and crB <= tableMaxBars
        if krB
            array.push(klbls, "R▼")
            array.push(kvals, int(crB))
            kHasBear := true
        else
            array.push(clbls, "R▼")
            array.push(cvals, int(crB))
            cHasBear := true
    // Hist bull
    if not na(chb) and chb <= tableMaxBars
        if khb
            array.push(klbls, "H▲")
            array.push(kvals, int(chb))
            kHasBull := true
        else
            array.push(clbls, "H▲")
            array.push(cvals, int(chb))
            cHasBull := true
    // Hist bear
    if not na(chB) and chB <= tableMaxBars
        if khB
            array.push(klbls, "H▼")
            array.push(kvals, int(chB))
            kHasBear := true
        else
            array.push(clbls, "H▼")
            array.push(cvals, int(chB))
            cHasBear := true
    // MACD bull
    if not na(cmb) and cmb <= tableMaxBars
        if kmb
            array.push(klbls, "M▲")
            array.push(kvals, int(cmb))
            kHasBull := true
        else
            array.push(clbls, "M▲")
            array.push(cvals, int(cmb))
            cHasBull := true
    // MACD bear
    if not na(cmB) and cmB <= tableMaxBars
        if kmB
            array.push(klbls, "M▼")
            array.push(kvals, int(cmB))
            kHasBear := true
        else
            array.push(clbls, "M▼")
            array.push(cvals, int(cmB))
            cHasBear := true
    // Bubble-sort confirmed descending by barssince
    nc = array.size(cvals)
    if nc > 1
        for i = 0 to nc - 2
            for j = 0 to nc - 2 - i
                if array.get(cvals, j) < array.get(cvals, j + 1)
                    vj  = array.get(cvals, j)
                    vj1 = array.get(cvals, j + 1)
                    lj  = array.get(clbls, j)
                    lj1 = array.get(clbls, j + 1)
                    array.set(cvals, j,     vj1)
                    array.set(cvals, j + 1, vj)
                    array.set(clbls, j,     lj1)
                    array.set(clbls, j + 1, lj)
    cs = ""
    if nc > 0
        for i = 0 to nc - 1
            cs := cs + array.get(clbls, i) + str.tostring(array.get(cvals, i)) + " "
    // Build killed string sorted descending by barssince
    nk = array.size(kvals)
    if nk > 1
        for i = 0 to nk - 2
            for j = 0 to nk - 2 - i
                if array.get(kvals, j) < array.get(kvals, j + 1)
                    vj  = array.get(kvals, j)
                    vj1 = array.get(kvals, j + 1)
                    lj  = array.get(klbls, j)
                    lj1 = array.get(klbls, j + 1)
                    array.set(kvals, j,     vj1)
                    array.set(kvals, j + 1, vj)
                    array.set(klbls, j,     lj1)
                    array.set(klbls, j + 1, lj)
    ks = ""
    if nk > 0
        for i = 0 to nk - 1
            ks := ks + array.get(klbls, i) + str.tostring(array.get(kvals, i)) + " "
    cMinBars = nc > 0 ? array.min(cvals) : 0
    kMinBars = nk > 0 ? array.min(kvals) : 0
    cbg = cHasBull and cHasBear ? mtfBothBg 
       : cHasBull ? age_color(true,  cMinBars)
       : cHasBear ? age_color(false, cMinBars)
       : color.new(#1e222d, 0)
    // Killed bull → red (bearish signal), killed bear → green (bullish signal)
    kbg = kHasBull and kHasBear ? mtfBothBg
       : kHasBull ? age_color(false, kMinBars)
       : kHasBear ? age_color(true,  kMinBars)
       : color.new(#1e222d, 0)
    [cs, ks, cbg, kbg]

var table mtfTable = na

if barstate.islast
    tblPos_val = switch tablePos
        "top_right"     => position.top_right
        "bottom_left"   => position.bottom_left
        "bottom_right"  => position.bottom_right
        "top_center"    => position.top_center
        "bottom_center" => position.bottom_center
        =>               position.top_left

    // Collect only TFs with at least one active signal
    activeLabels  = array.new_string()
    activeSigs    = array.new_string()
    activeBgs     = array.new_color()
    activeConf    = array.new_string()
    activeConfBgs = array.new_color()
    activeKill    = array.new_string()
    activeKillBgs = array.new_color()

    if show1m
        s = (r1m_rb ? "R▲ " : "") + (r1m_rB ? "R▼ " : "") + (r1m_hb ? "H▲ " : "") + (r1m_hB ? "H▼ " : "") + (r1m_mb ? "M▲ " : "") + (r1m_mB ? "M▼ " : "")
        [cs, ks, cbg, kbg] = f_confStr(r1m_crb, r1m_crB, r1m_chb, r1m_chB, r1m_cmb, r1m_cmB, r1m_krb, r1m_krB, r1m_khb, r1m_khB, r1m_kmb, r1m_kmB)
        if str.length(s) > 0 or str.length(cs) > 0 or str.length(ks) > 0
            array.push(activeLabels,  "1m")
            array.push(activeSigs,    str.length(s)  > 0 ? s  : "—")
            array.push(activeBgs,     str.length(s)  > 0 ? ((r1m_rb or r1m_hb or r1m_mb) and (r1m_rB or r1m_hB or r1m_mB) ? mtfBothBg : (r1m_rb or r1m_hb or r1m_mb) ? mtfBullBg : mtfBearBg) : mtfHdrBg)
            array.push(activeConf,    str.length(cs) > 0 ? cs : "—")
            array.push(activeConfBgs, cbg)
            array.push(activeKill,    str.length(ks) > 0 ? ks : "—")
            array.push(activeKillBgs, str.length(ks) > 0 ? kbg : mtfHdrBg)
    if show5m
        s = (r5m_rb ? "R▲ " : "") + (r5m_rB ? "R▼ " : "") + (r5m_hb ? "H▲ " : "") + (r5m_hB ? "H▼ " : "") + (r5m_mb ? "M▲ " : "") + (r5m_mB ? "M▼ " : "")
        [cs, ks, cbg, kbg] = f_confStr(r5m_crb, r5m_crB, r5m_chb, r5m_chB, r5m_cmb, r5m_cmB, r5m_krb, r5m_krB, r5m_khb, r5m_khB, r5m_kmb, r5m_kmB)
        if str.length(s) > 0 or str.length(cs) > 0 or str.length(ks) > 0
            array.push(activeLabels,  "5m")
            array.push(activeSigs,    str.length(s)  > 0 ? s  : "—")
            array.push(activeBgs,     str.length(s)  > 0 ? ((r5m_rb or r5m_hb or r5m_mb) and (r5m_rB or r5m_hB or r5m_mB) ? mtfBothBg : (r5m_rb or r5m_hb or r5m_mb) ? mtfBullBg : mtfBearBg) : mtfHdrBg)
            array.push(activeConf,    str.length(cs) > 0 ? cs : "—")
            array.push(activeConfBgs, cbg)
            array.push(activeKill,    str.length(ks) > 0 ? ks : "—")
            array.push(activeKillBgs, str.length(ks) > 0 ? kbg : mtfHdrBg)
    if show15m
        s = (r15m_rb ? "R▲ " : "") + (r15m_rB ? "R▼ " : "") + (r15m_hb ? "H▲ " : "") + (r15m_hB ? "H▼ " : "") + (r15m_mb ? "M▲ " : "") + (r15m_mB ? "M▼ " : "")
        [cs, ks, cbg, kbg] = f_confStr(r15m_crb, r15m_crB, r15m_chb, r15m_chB, r15m_cmb, r15m_cmB, r15m_krb, r15m_krB, r15m_khb, r15m_khB, r15m_kmb, r15m_kmB)
        if str.length(s) > 0 or str.length(cs) > 0 or str.length(ks) > 0
            array.push(activeLabels,  "15m")
            array.push(activeSigs,    str.length(s)  > 0 ? s  : "—")
            array.push(activeBgs,     str.length(s)  > 0 ? ((r15m_rb or r15m_hb or r15m_mb) and (r15m_rB or r15m_hB or r15m_mB) ? mtfBothBg : (r15m_rb or r15m_hb or r15m_mb) ? mtfBullBg : mtfBearBg) : mtfHdrBg)
            array.push(activeConf,    str.length(cs) > 0 ? cs : "—")
            array.push(activeConfBgs, cbg)
            array.push(activeKill,    str.length(ks) > 0 ? ks : "—")
            array.push(activeKillBgs, str.length(ks) > 0 ? kbg : mtfHdrBg)
    if show1h
        s = (r1h_rb ? "R▲ " : "") + (r1h_rB ? "R▼ " : "") + (r1h_hb ? "H▲ " : "") + (r1h_hB ? "H▼ " : "") + (r1h_mb ? "M▲ " : "") + (r1h_mB ? "M▼ " : "")
        [cs, ks, cbg, kbg] = f_confStr(r1h_crb, r1h_crB, r1h_chb, r1h_chB, r1h_cmb, r1h_cmB, r1h_krb, r1h_krB, r1h_khb, r1h_khB, r1h_kmb, r1h_kmB)
        if str.length(s) > 0 or str.length(cs) > 0 or str.length(ks) > 0
            array.push(activeLabels,  "1h")
            array.push(activeSigs,    str.length(s)  > 0 ? s  : "—")
            array.push(activeBgs,     str.length(s)  > 0 ? ((r1h_rb or r1h_hb or r1h_mb) and (r1h_rB or r1h_hB or r1h_mB) ? mtfBothBg : (r1h_rb or r1h_hb or r1h_mb) ? mtfBullBg : mtfBearBg) : mtfHdrBg)
            array.push(activeConf,    str.length(cs) > 0 ? cs : "—")
            array.push(activeConfBgs, cbg)
            array.push(activeKill,    str.length(ks) > 0 ? ks : "—")
            array.push(activeKillBgs, str.length(ks) > 0 ? kbg : mtfHdrBg)
    if show4h
        s = (r4h_rb ? "R▲ " : "") + (r4h_rB ? "R▼ " : "") + (r4h_hb ? "H▲ " : "") + (r4h_hB ? "H▼ " : "") + (r4h_mb ? "M▲ " : "") + (r4h_mB ? "M▼ " : "")
        [cs, ks, cbg, kbg] = f_confStr(r4h_crb, r4h_crB, r4h_chb, r4h_chB, r4h_cmb, r4h_cmB, r4h_krb, r4h_krB, r4h_khb, r4h_khB, r4h_kmb, r4h_kmB)
        if str.length(s) > 0 or str.length(cs) > 0 or str.length(ks) > 0
            array.push(activeLabels,  "4h")
            array.push(activeSigs,    str.length(s)  > 0 ? s  : "—")
            array.push(activeBgs,     str.length(s)  > 0 ? ((r4h_rb or r4h_hb or r4h_mb) and (r4h_rB or r4h_hB or r4h_mB) ? mtfBothBg : (r4h_rb or r4h_hb or r4h_mb) ? mtfBullBg : mtfBearBg) : mtfHdrBg)
            array.push(activeConf,    str.length(cs) > 0 ? cs : "—")
            array.push(activeConfBgs, cbg)
            array.push(activeKill,    str.length(ks) > 0 ? ks : "—")
            array.push(activeKillBgs, str.length(ks) > 0 ? kbg : mtfHdrBg)

    // Rebuild table only when needed
    if not na(mtfTable)
        table.delete(mtfTable)
        mtfTable := na

    nActive = array.size(activeLabels)
    if nActive > 0
        mtfTable := table.new(tblPos_val, 4, nActive + 1,
             bgcolor      = color.new(#1e222d, 0),
             border_width = 1,
             border_color = color.new(color.gray, 70))
        table.cell(mtfTable, 0, 0, "TF",        bgcolor=mtfHdrBg, text_color=mtfHdrCl, text_size=size.small)
        table.cell(mtfTable, 1, 0, "P", bgcolor=mtfHdrBg, text_color=mtfHdrCl, text_size=size.small)
        table.cell(mtfTable, 2, 0, "C", bgcolor=mtfHdrBg, text_color=mtfHdrCl, text_size=size.small)
        table.cell(mtfTable, 3, 0, "K",    bgcolor=mtfHdrBg, text_color=mtfHdrCl, text_size=size.small)
        for i = 0 to nActive - 1
            table.cell(mtfTable, 0, i + 1, array.get(activeLabels,  i), bgcolor=mtfTfBg,                       text_color=mtfTxtCl, text_size=size.small)
            table.cell(mtfTable, 1, i + 1, array.get(activeSigs,    i), bgcolor=array.get(activeBgs,     i),    text_color=mtfTxtCl, text_size=size.small)
            table.cell(mtfTable, 2, i + 1, array.get(activeConf,    i), bgcolor=array.get(activeConfBgs, i),    text_color=mtfTxtCl, text_size=size.small)
            table.cell(mtfTable, 3, i + 1, array.get(activeKill,    i), bgcolor=array.get(activeKillBgs, i),    text_color=mtfTxtCl, text_size=size.small)
